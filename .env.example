# Frontend (Vercel) - Variables à définir dans Vercel > Settings > Environment Variables
# En local, copier en .env.local

# URL de l’API backend (après déploiement sur Render)
NEXT_PUBLIC_API_URL=https://votre-api.onrender.com

# Supabase (requis pour l’auth)
NEXT_PUBLIC_SUPABASE_URL=https://xxx.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key
