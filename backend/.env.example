# Backend - Exemple pour Render / production
# Copier en .env en local ; sur Render, définir ces variables dans Environment.

# Base de données (Render fournit DATABASE_URL si vous ajoutez PostgreSQL)
DATABASE_URL=postgresql://user:password@host:5432/database
# Ou en local avec variables séparées :
# DB_HOST=localhost
# DB_PORT=5432
# DB_NAME=amicale
# DB_USER=postgres
# DB_PASSWORD=

# JWT
JWT_SECRET=your-secret-key
JWT_EXPIRES_IN=7d

# CORS - URL du frontend (Vercel)
FRONTEND_URL=https://votre-app.vercel.app

# Serveur (Render définit PORT automatiquement)
PORT=4000

# Uploads (optionnel)
UPLOAD_DIR=./uploads

# SMTP (optionnel, pour envoi d’emails)
# SMTP_HOST=
# SMTP_PORT=587
# SMTP_USER=
# SMTP_PASS=
# MAIL_FROM=
